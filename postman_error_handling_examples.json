            },
            "description": "Test non-enrolled student trying to login - should return 403"
          },
          "response": [
            {
              "name": "403 Forbidden - Student Not Enrolled",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/auth/github/callback?code=test_code",
                  "host": ["{{base_url}}"],
