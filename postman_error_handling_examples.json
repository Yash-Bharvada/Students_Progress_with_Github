    {
      "name": "Authorization Violations",
      "description": "Examples of authorization violations with 403 responses and logging",
      "item": [
        {
          "name": "Student Not Enrolled - OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/github/callback?code=test_code_for_non_enrolled_student",
