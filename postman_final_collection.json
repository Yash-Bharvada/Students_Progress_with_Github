	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-extract JWT token from OAuth callback response",
					"if (pm.response && pm.response.json && pm.response.json().access_token) {",
					"    pm.environment.set('jwt_token', pm.response.json().access_token);",
					"}"
				]
			}
		}
	],
