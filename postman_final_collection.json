						},
						"url": {
							"raw": "{{base_url}}/graphql",
							"host": ["{{base_url}}"],
							"path": ["graphql"]
						}
					},
					"response": []
				},
				{
					"name": "Student Trying to Enroll Another Student",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{student_jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"mutation EnrollStudent($input: EnrollStudentInput!) { enrollStudent(input: $input) { id username } }\",\n  \"variables\": {\n    \"input\": {\n      \"githubUsername\": \"anotherstudent\",\n      \"email\": \"another@example.com\"\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/graphql",
							"host": ["{{base_url}}"],
							"path": ["graphql"]
						}
					},
					"response": []
				},
				{
					"name": "OAuth Callback Missing Code",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/github/callback",
							"host": ["{{base_url}}"],
							"path": ["auth", "github", "callback"]
						}
					},
					"response": []
				}
			]
		}
